FROM fedora:44

ARG USERNAME=tux
ARG USER_UID=1000
ARG USER_GID=1000

ENV TZ=America/La_Paz
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime

RUN dnf install -y \
    --setopt=install_weak_deps=False \
    --setopt=tsflags=nodocs \
    git-core \
    zsh \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/lib/dnf/history* /tmp/* /var/tmp/*
RUN sh -c "$(curl -fsLS get.chezmoi.io)" -- -b /usr/local/bin
RUN curl -Ls --tlsv1.2 --proto "=https" --retry 3 https://cli.doppler.com/install.sh | sh
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -G wheel -s /bin/zsh \
    && echo '%wheel ALL=(ALL) NOPASSWD:ALL' \
    > /etc/sudoers.d/wheel-nopasswd \
    && chmod 0440 /etc/sudoers.d/wheel-nopasswd

USER $USERNAME
COPY config/chezmoi.yaml /home/$USERNAME/.config/chezmoi/chezmoi.yaml
WORKDIR /home/$USERNAME/.local/share/chezmoi

CMD ["/bin/zsh", "--login"]

