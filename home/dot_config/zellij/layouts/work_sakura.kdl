layout {
  tab name="zellij" focus=true {
    pane
  }
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        format_left "{mode} #[fg=#c5a3a9,bold]{tabs}"
        format_center "#[fg=#c5a3a9,bold]"
        format_right "{command_git_branch} {datetime}"
        format_space ""
        border_enabled "false"
        border_char "─"
        border_format "#[fg=#3f3b3e]{char}"
        border_position "top"
        mode_normal "#[bg=#878fb9] "
        mode_tmux "#[bg=#c58ea7] "
        tab_normal "#[fg=#786577]{index}:{name} "
        tab_active "#[fg=#C65C5B,bold,italic]{index}:{name} "
        command_git_branch_command "git rev-parse --abbrev-ref HEAD"
        command_git_branch_format "#[fg=#878fb9] {stdout} "
        command_git_branch_interval "10"
        command_git_branch_rendermode "static"
        datetime "#[fg=#786577,bold] {format} "
        datetime_format "%A, %d %b %Y"
        datetime_timezone "America/La_Paz"
      }
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }
}
